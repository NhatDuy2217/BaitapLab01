<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Bài 2 - Table</title>

    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .layout {
            width: 500px;
            height: 300px;
            border-collapse: collapse;
            margin: 30px auto;
        }

            .layout td {
                border: 2px solid #555;
            }

        .title {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-top: 40px;
        }

        .number {
            text-align: center;
            font-size: 30px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="title">BÀI 2 - SỬ DỤNG TABLE</div>

    <!-- LAYOUT 1 -->
    <table class="layout">

        <!-- Hàng trên -->
        <tr>
            <td colspan="2" height="60">
            </td>
        </tr>

        <!-- Hàng dưới -->
        <tr>
            <!-- Cột trái -->
            <td width="25%">
            </td>

            <!-- Nội dung -->
            <td>
                <div class="number">1</div>
            </td>
        </tr>

    </table>

    <!-- LAYOUT 2 -->
    <table class="layout">

        <!-- Hàng trên -->
        <tr>
            <td colspan="2" height="60">
            </td>
        </tr>

        <!-- Hàng dưới -->
        <tr>
            <!-- Nội dung -->
            <td>
                <div class="number">2</div>
            </td>

            <!-- Cột phải -->
            <td width="20%">
            </td>
        </tr>

    </table>

    <!-- LAYOUT 3 -->
    <table class="layout">

        <!-- Phần trên -->
        <tr>
            <td colspan="2" height="60">
            </td>
        </tr>

        <!-- Phần giữa -->
        <tr>
            <td height="180">
                <div class="number">3</div>
            </td>

            <td width="20%">
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td colspan="2" height="60">
            </td>
        </tr>

    </table>

    <!-- LAYOUT 4 -->
    <table class="layout">

        <!-- Header -->
        <tr>
            <td colspan="2" height="60">
            </td>
        </tr>

        <!-- Thanh ngang -->
        <tr>
            <td colspan="2" height="30">
            </td>
        </tr>

        <!-- Nội dung -->
        <tr>
            <!-- Cột trái -->
            <td width="25%">
            </td>

            <!-- Nội dung chính -->
            <td>
                <div class="number">4</div>
            </td>
        </tr>

    </table>

    <!-- LAYOUT 5 -->
    <table class="layout">

        <!-- Hàng trên -->
        <tr>

            <!-- Ô trái -->
            <td width="55%" height="60">
            </td>

            <!-- Ô phải -->
            <td width="45%">
            </td>

        </tr>

        <!-- Thanh ngang -->
        <tr>
            <td colspan="2" height="30">
            </td>
        </tr>

        <!-- Nội dung -->
        <tr>

            <!-- Menu trái -->
            <td width="25%">
            </td>

            <!-- Nội dung -->
            <td>
                <div class="number">5</div>
            </td>

        </tr>

    </table>

    <!-- LAYOUT 6 -->
    <table class="layout">

        <!-- Hàng trên -->
        <tr>

            <!-- Ô trái -->
            <td width="35%" height="60">
            </td>

            <!-- Ô phải -->
            <td>
            </td>

        </tr>

        <!-- Nội dung -->
        <tr>

            <!-- Menu trái -->
            <td width="20%">
            </td>

            <!-- Nội dung chính -->
            <td>
                <div class="number">6</div>
            </td>

            <!-- Cột phải -->
            <td width="20%">
            </td>

        </tr>

        <!-- Footer -->
        <tr>

            <td colspan="3" height="60">
            </td>

        </tr>

    </table>

</body>
</html>