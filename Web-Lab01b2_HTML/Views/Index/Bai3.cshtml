<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Bài 3 - Sử dụng DIV</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: white;
        }

        h1 {
            text-align: center;
            margin-bottom: 40px;
        }

        .layout {
            width: 600px;
            height: 350px;
            margin: 40px auto;
            border: 2px solid #555;
            position: relative;
        }

        .box {
            border: 2px solid #555;
            position: absolute;
            box-sizing: border-box;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 25px;
            font-weight: bold;
        }

        /* BÀI 3 - LAYOUT 1 */
        .layout1 .header {
            top: 0;
            left: 0;
            width: 100%;
            height: 25%;
        }

        .layout1 .left {
            top: 25%;
            left: 0;
            width: 25%;
            height: 75%;
        }

        .layout1 .content {
            top: 25%;
            left: 25%;
            width: 75%;
            height: 75%;
        }

        /* LAYOUT 2 */
        .layout2 .header {
            top: 0;
            left: 0;
            width: 100%;
            height: 25%;
        }

        .layout2 .content {
            top: 25%;
            left: 0;
            width: 80%;
            height: 75%;
        }

        .layout2 .right {
            top: 25%;
            right: 0;
            width: 20%;
            height: 75%;
        }

        /* LAYOUT 3 */
        .layout3 .header {
            top: 0;
            left: 0;
            width: 100%;
            height: 25%;
        }

        .layout3 .content {
            top: 25%;
            left: 0;
            width: 80%;
            height: 60%;
        }

        .layout3 .right {
            top: 25%;
            right: 0;
            width: 20%;
            height: 60%;
        }

        .layout3 .footer {
            bottom: 0;
            left: 0;
            width: 100%;
            height: 15%;
        }

        /* LAYOUT 4 */
        .layout4 .header {
            top: 0;
            left: 0;
            width: 100%;
            height: 22%;
        }

        .layout4 .menu {
            top: 22%;
            left: 0;
            width: 100%;
            height: 10%;
        }

        .layout4 .left {
            top: 32%;
            left: 0;
            width: 25%;
            height: 68%;
        }

        .layout4 .content {
            top: 32%;
            left: 25%;
            width: 75%;
            height: 68%;
        }

        /* LAYOUT 5 */
        .layout5 .logo {
            top: 0;
            left: 0;
            width: 70%;
            height: 22%;
        }

        .layout5 .right-menu {
            top: 0;
            right: 0;
            width: 30%;
            height: 22%;
        }

        .layout5 .menu {
            top: 22%;
            left: 0;
            width: 100%;
            height: 10%;
        }

        .layout5 .left {
            top: 32%;
            left: 0;
            width: 22%;
            height: 68%;
        }

        .layout5 .content {
            top: 32%;
            left: 22%;
            width: 78%;
            height: 68%;
        }

        /* LAYOUT 6 */
        .layout6 .logo {
            top: 0;
            left: 0;
            width: 42%;
            height: 22%;
        }

        .layout6 .menu {
            top: 0;
            right: 0;
            width: 58%;
            height: 22%;
        }

        .layout6 .left {
            top: 22%;
            left: 0;
            width: 20%;
            height: 78%;
        }

        .layout6 .content {
            top: 22%;
            left: 20%;
            width: 60%;
            height: 78%;
        }

        .layout6 .right {
            top: 22%;
            right: 0;
            width: 20%;
            height: 78%;
        }
    </style>

</head>

<body>

    <h1>BÀI 3 - SỬ DỤNG DIV</h1>

    <!-- LAYOUT 1 -->
    <h2 style="text-align:center;">Layout 1</h2>

    <div class="layout layout1">

        <div class="box header">
            HEADER
        </div>

        <div class="box left">
            MENU
        </div>

        <div class="box content">
            1
        </div>

    </div>

    <!-- LAYOUT 2 -->
    <h2 style="text-align:center;">Layout 2</h2>

    <div class="layout layout2">

        <div class="box header">
            HEADER
        </div>

        <div class="box content">
            2
        </div>

        <div class="box right">
            MENU
        </div>

    </div>

    <!-- LAYOUT 3 -->
    <h2 style="text-align:center;">Layout 3</h2>

    <div class="layout layout3">

        <div class="box header">
            HEADER
        </div>

        <div class="box content">
            3
        </div>

        <div class="box right">
            RIGHT
        </div>

        <div class="box footer">
            FOOTER
        </div>

    </div>

    <!-- LAYOUT 4 -->
    <h2 style="text-align:center;">Layout 4</h2>

    <div class="layout layout4">

        <div class="box header">
            HEADER
        </div>

        <div class="box menu">
            MENU
        </div>

        <div class="box left">
            LEFT
        </div>

        <div class="box content">
            4
        </div>

    </div>

    <!-- LAYOUT 5 -->
    <h2 style="text-align:center;">Layout 5</h2>

    <div class="layout layout5">

        <div class="box logo">
            LOGO
        </div>

        <div class="box right-menu">
            MENU
        </div>

        <div class="box menu">
            NAVIGATION
        </div>

        <div class="box left">
            LEFT
        </div>

        <div class="box content">
            5
        </div>

    </div>

    <!-- LAYOUT 6 -->
    <h2 style="text-align:center;">Layout 6</h2>

    <div class="layout layout6">

        <div class="box logo">
            LOGO
        </div>

        <div class="box menu">
            MENU
        </div>

        <div class="box left">
            LEFT
        </div>

        <div class="box content">
            6
        </div>

        <div class="box right">
            RIGHT
        </div>

    </div>


</body>
</html>